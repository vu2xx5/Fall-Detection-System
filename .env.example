# ==========================================================
#  Fall Detection System - Mẫu cấu hình
#  Sao chép file này thành `.env` rồi điền giá trị thật:
#      cp .env.example .env
#  File `.env` đã được .gitignore bỏ qua, KHÔNG bị đẩy lên GitHub.
# ==========================================================

# --- Nguồn video ---
# 0 = webcam mặc định | "test.mp4" = file video | "rtsp://user:pass@ip:554/..." = camera IP
VIDEO_SOURCE=0

# --- Trọng số mô hình ---
LSTM_WEIGHTS=best_fall_lstm.pth
YOLO_WEIGHTS=yolov8n-pose.pt

# --- Telegram Bot (tuỳ chọn) ---
# Lấy token từ @BotFather, lấy chat_id từ @userinfobot
# Để trống cả hai => hệ thống chỉ in cảnh báo ra terminal, không gửi Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tham số chống báo giả ---
# Mỗi track_id chỉ gửi tối đa 1 cảnh báo trong khoảng thời gian này (giây)
ALERT_COOLDOWN_SEC=60

# Ngưỡng xác suất của Bi-LSTM để coi là ngã (0.0 - 1.0)
FALL_PROB_THRESHOLD=0.75
# Ngưỡng dưới để reset đồng hồ xác suất (hysteresis chống dao động)
FALL_PROB_RESET=0.40

# Góc thân ≤ giá trị này = đang đứng/đi (độ)
UPRIGHT_TORSO_ANGLE=35.0
# Góc thân ≥ giá trị này = nằm ngang (độ)
FALL_TORSO_ANGLE=55.0

# Chuyển tư thế đứng→nằm nhanh hơn giá trị này mới tính là ngã (giây)
FALL_TRANSITION_SEC=1.5
# Phải nằm ngang + prob cao liên tục bao lâu mới xác nhận ngã (giây)
FALL_HOLD_SEC=1.0

# Số keypoint tối thiểu phải nhìn rõ trong 1 frame (trên 17) để dùng frame đó
MIN_VALID_KEYPOINTS=6
# Độ tin cậy tối thiểu của một keypoint để coi là nhìn rõ
MIN_CONF_KEYPOINT=0.30
# Xoá trạng thái của một ID nếu nó biến mất khỏi khung hình quá số frame này
MAX_INACTIVE_FRAMES=150
